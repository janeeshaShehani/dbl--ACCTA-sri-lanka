# ============================================================
#  ACCTA Sri Lanka – Environment Variable Template
#  Copy this file to .env.local and fill in real values.
#  This file is safe to commit – it contains NO secrets.
# ============================================================

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------
# MEMBERSHIP FORMS
# Used for: Individual & Corporate membership application emails
#   MEMBERSHIP_FROM_EMAIL  – "From" address on emails sent to applicants
#   MEMBERSHIP_ADMIN_EMAIL – receives new-application alert emails
# ----------------------------------------------------------
MEMBERSHIP_FROM_EMAIL=ACCTA Membership <membership@acctasl.com>
MEMBERSHIP_ADMIN_EMAIL=membership@acctasl.com

# ----------------------------------------------------------
# CONTACT FORM
# Used for: Contact-page enquiry submissions
#   CONTACT_FROM_EMAIL  – "From" address on the notification email
#   CONTACT_ADMIN_EMAIL – receives new contact-enquiry emails
# ----------------------------------------------------------
CONTACT_FROM_EMAIL=ACCTA Sri Lanka <info@acctasl.com>
CONTACT_ADMIN_EMAIL=info@acctasl.com
